# Copy to .env at the repo root if you need to override defaults.
# docker compose reads this automatically (same directory as
# docker-compose.yml) — no extra flag needed.

# REQUIRED: password for the Postgres database (any long random string).
# Generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Comma-separated list of extra origins allowed to call the API directly.
# Defaults to https://rischwealth.com,https://www.rischwealth.com if unset.
# CORS_ORIGIN=https://rischwealth.com,https://www.rischwealth.com

# Staff emails (a new testimonial is emailed for review). Gmail needs an
# App Password: Google Account > Security > 2-Step Verification > App
# passwords. Without SMTP_PASS nothing is sent.
# SMTP_USER=rischwealth@gmail.com
# SMTP_PASS=
# MAIL_TO=rischwealth@gmail.com
